	"quest.1108000000000001.quest_desc": [
		"Os protagonistas lendários do mangá &6Pokémon Adventures (PokéSpe)&r cruzaram os horizontes para o teste supremo do servidor!"
		""
		"• &eSérie na Trainer Association:&r &6Pokemon Adventures&r."
		"• Derrote &eYellow&r para despertar os trios de Johto, Hoenn e Sinnoh, além do quarteto de Unova, rumo aos mestres originais de Kanto!"
	]
	"quest.1108000000000001.quest_subtitle": "&7Os 17 Protagonistas de Pokémon Adventures"
	"quest.1108000000000001.title": "&6O Panteão dos Mestres do Mangá"
	"quest.1108000000000002.quest_desc": [
		"Dotada do poder místico da Floresta de Viridian, &eYellow&r abre o desafio dos portadores da Pokédex!"
		"Superá-la desbloqueia simultaneamente as jornadas de &6Johto&r, &9Hoenn&r e &bSinnoh&r."
	]
	"quest.1108000000000002.quest_subtitle": "&7O Despertar da Lenda • Equipe Nv. 405"
	"quest.1108000000000002.title": "&eA Guardiã de Viridian: Yellow"
	"quest.1108000000000003.quest_desc": [
		"Enfrente em sequência a especialista em captura &bCrystal&r (Nv. 415), o audacioso &6Gold&r (Nv. 425) e o estrategista &7Silver&r (Nv. 434)!"
	]
	"quest.1108000000000003.quest_subtitle": "&7Os Herdeiros de Johto • Equipes Nv. 415 a 434"
	"quest.1108000000000003.title": "&6Trio de Johto: Crystal, Gold e Silver"
	"quest.1108000000000004.quest_desc": [
		"Supere em ordem &cRuby&r (Nv. 415), &9Sapphire&r (Nv. 425) e o prodígio da Battle Frontier &aEmerald&r (Nv. 434)!"
	]
	"quest.1108000000000004.quest_subtitle": "&7Os Guardiões da Fronteira • Equipes Nv. 415 a 434"
	"quest.1108000000000004.title": "&9Trio de Hoenn: Ruby, Sapphire e Emerald"
	"quest.1108000000000005.quest_desc": [
		"Vença em ordem &7Diamond&r (Nv. 415), &ePearl&r (Nv. 425) e &bLady Platinum Berlitz&r (Nv. 434)!"
	]
	"quest.1108000000000005.quest_subtitle": "&7Guardiões do Tempo e Espaço • Equipes Nv. 415 a 434"
	"quest.1108000000000005.title": "&bTrio de Sinnoh: Diamond, Pearl e Platinum"
	"quest.1108000000000006.quest_desc": [
		"Desafie os quatro heróis de Unova do mangá: &aWhitley&r (Nv. 415), &fWhite&r (Nv. 425), &9Blake&r (Nv. 434) e &8Black&r (Nv. 444)!"
	]
	"quest.1108000000000006.quest_subtitle": "&7Sonhadores da Verdade e Ideais • Equipes Nv. 415 a 444"
	"quest.1108000000000006.title": "&8Quarteto de Unova: Whitley, White, Blake e Black"
	"quest.1108000000000007.quest_desc": [
		"Após provar seu valor diante dos trios de Johto, Hoenn e Sinnoh, &aGreen&r (Nv. 444) e &bBlue&r (Nv. 450) aceitam seu desafio!"
	]
	"quest.1108000000000007.quest_subtitle": "&7A Estrategista Astuta e o Mestre Tático • Nv. 444 e Nv. 450"
	"quest.1108000000000007.title": "&aVeteranos de Pallet: Green e Blue"
	"quest.1108000000000008.quest_desc": [
		"Com Green e Blue superados, o lendário &cRed&r entra em campo com sua equipe icônica para o duelo derradeiro de Kanto!"
	]
	"quest.1108000000000008.quest_subtitle": "&eO Campeão Original do Mangá • Equipe Nv. 449"
	"quest.1108000000000008.title": "&c&lO Lutador Supremo: Red (PokéSpe)"
	"quest.1108000000000009.quest_desc": [
		"Você alcançou o que poucos treinadores ousaram sonhar!"
		"Todas as regiões, todas as organizações criminosas e todos os 17 protagonistas lendários de Pokémon Adventures foram superados."
		""
		"&6&lVocê é agora uma Lenda Imortal do universo de Limbo Cobblemon!&r"
	]
	"quest.1108000000000009.quest_subtitle": "&eConquistador Absoluto de Todas as Séries e Lendas!"
	"quest.1108000000000009.title": "&6&lO Mestre Supremo de Limbo Cobblemon"
